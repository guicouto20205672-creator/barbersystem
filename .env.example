# Copy this file to .env before starting the local environment.
# Never commit .env or place real credentials in this file.

DOMAIN=localhost:18091
VERSION=2026.9.0

# Keep this password identical in POSTGRES_PASSWORD and DB_DSN.
POSTGRES_USER=corteza
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=corteza
DB_DSN=postgres://corteza:change-this-local-password@db:5432/corteza?sslmode=disable

# Replace with a long random value before starting Corteza.
AUTH_JWT_SECRET=replace-with-a-long-random-secret-before-starting

HTTP_WEBAPP_ENABLED=true

# Corredor automation service
CORREDOR_ENABLED=true
CORREDOR_EXT_SEARCH_PATHS=/extensions
CORREDOR_EXEC_CSERVERS_API_HOST=server:80/api
CORREDOR_LOG_ENABLED=true
CORREDOR_LOG_PRETTY=true
CORREDOR_LOG_LEVEL=info
CORREDOR_EXEC_CSERVERS_API_BASEURL_TEMPLATE=server:80/api/{service}
CORREDOR_ADDR=corredor:53051
